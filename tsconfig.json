{
	"include": [
		"./src/**/*"
	],
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "./scripts",
		"rewriteRelativeImportExtensions": true,
		"rootDir": "src/",
	},
}
